# ========================================
# OHANA API - Environment Variables
# ========================================

# ========================================
# DATABASE
# ========================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# Production: Use Neon PostgreSQL connection string
# Development: Local PostgreSQL or Neon DEV project
DATABASE_URL="postgresql://user:password@localhost:5432/ohana_db"

# ========================================
# JWT AUTHENTICATION
# ========================================
# Secret key for signing JWT tokens
# IMPORTANT: Change this to a strong random string in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-secret-key-change-in-production"

# JWT token expiration time
# Examples: '7d' (7 days), '24h' (24 hours), '60m' (60 minutes)
JWT_EXPIRES_IN="7d"

# ========================================
# APPLICATION
# ========================================
# Application environment
# Options: development, production, test
NODE_ENV="development"

# Application port
PORT=3000

# CORS allowed origins (comma-separated for multiple origins)
# Development: http://localhost:3000,http://localhost:3001
# Production: https://www.ohanasushidelivery.com.br,https://admin.ohanasushidelivery.com.br
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# ========================================
# CLOUDINARY (Image Upload)
# ========================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ========================================
# EMAIL (Email Verification - Future Implementation)
# ========================================
EMAIL_HOST=""
EMAIL_PORT=""
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM=""

# ========================================
# RATE LIMITING (Security - Future Implementation)
# ========================================
RATE_LIMIT_TTL="60"        # Time window in seconds
RATE_LIMIT_MAX="100"       # Max requests per time window

