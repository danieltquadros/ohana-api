generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CategoryType {
  PRODUCT
  COMBO
}

model Category {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  label       String
  description String?
  type        CategoryType
  order       Int
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   Int?
  updatedBy   Int?
  combos      Combo[]
  products    Product[]
  offers      OfferCategory[]
  @@map("categories")
}

model Combo {
  id          Int            @id @default(autoincrement())
  name        String         @unique
  description String?
  image       String
  price       Decimal        @db.Decimal(10, 2)
  order       Int
  isActive    Boolean        @default(true)
  validFrom   DateTime?
  validUntil  DateTime?
  discount    Decimal?       @db.Decimal(10, 2)
  categoryId  Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   Int?
  updatedBy   Int?
  category    Category?      @relation(fields: [categoryId], references: [id])
  products    ComboProduct[]
  offers      OfferCombo[]

  @@map("combos")
}

model ComboProduct {
  id             Int                        @id @default(autoincrement())
  comboId        Int
  productId      Int
  quantity       Int
  order          Int
  isCustomizable Boolean                    @default(false)
  combo          Combo                      @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product        Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  substitutions  ComboProductSubstitution[]

  @@unique([comboId, productId])
  @@map("combo_products")
}

model ComboProductSubstitution {
  id                  Int          @id @default(autoincrement())
  comboProductId      Int
  substituteProductId Int
  extraCost           Decimal      @db.Decimal(10, 2)
  comboProduct        ComboProduct @relation(fields: [comboProductId], references: [id], onDelete: Cascade)
  substituteProduct   Product      @relation("ProductSubstitutions", fields: [substituteProductId], references: [id], onDelete: Cascade)

  @@unique([comboProductId, substituteProductId])
  @@map("combo_product_substitutions")
}

model Product {
  id            Int                        @id @default(autoincrement())
  title         String
  image         String
  price         Decimal                    @db.Decimal(10, 2)
  order         Int
  isActive      Boolean                    @default(true)
  productTypeId Int
  categoryId    Int?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  createdBy     Int?
  updatedBy     Int?
  type          ProductType                @relation(fields: [productTypeId], references: [id])
  category      Category?                  @relation(fields: [categoryId], references: [id])
  ingredients   ProductIngredient[]
  combos        ComboProduct[]
  offers        OfferProduct[]
  substitutions ComboProductSubstitution[] @relation("ProductSubstitutions")

  @@map("products")
}

model ProductType {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  label       String
  isActive    Boolean      @default(true)
  products    Product[]
  menuSection MenuSection?
  offers      OfferProductType[]

  @@map("product_types")
}

enum MenuSectionKind {
  PRODUCT_TYPE
  COMBOS
}

model MenuSection {
  id            Int             @id @default(autoincrement())
  label         String
  order         Int
  isActive      Boolean         @default(true)
  kind          MenuSectionKind
  productTypeId Int?            @unique
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  createdBy     Int?
  updatedBy     Int?
  productType   ProductType?    @relation(fields: [productTypeId], references: [id], onDelete: Restrict)

  @@map("menu_sections")
}

model Ingredient {
  id           Int                 @id @default(autoincrement())
  name         String              @unique
  description  String?
  isAllergenic Boolean?            @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  createdBy    Int?
  updatedBy    Int?
  products     ProductIngredient[]

  @@map("ingredients")
}

model ProductIngredient {
  id           Int        @id @default(autoincrement())
  productId    Int
  ingredientId Int
  quantity     Int
  order        Int
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([productId, ingredientId])
  @@map("product_ingredients")
}

enum OfferKind {
  PERCENTAGE
  FIXED_AMOUNT
  FIXED_PRICE
  FREE_SHIPPING
}

enum OfferScope {
  PRODUCT
  COMBO
  CATEGORY
  PRODUCT_TYPE
  CART_TOTAL
}

enum DayOfWeek {
  SUN
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

model Offer{
  id Int @id @default(autoincrement())
  label String
  description String?

  // O que é o desconto
  kind OfferKind
  scope OfferScope
  percentage Decimal? @db.Decimal(5, 2) // Ex: 10.00 para 10%
  fixedAmount Decimal? @db.Decimal(10, 2) // Ex: 5.00 para R$5 de desconto

  // Pré condições
  minOrderValue Decimal? @db.Decimal(10, 2) // Só vale se carrinho >= X
  maxDiscountValue Decimal? @db.Decimal(10, 2) // teto de desconto (para %)

  // Janela temporal
  validFrom DateTime? // ex: 2026-04-10 00:00 BRT
  validUntil DateTime? // ex: 2026-04-20 23:59 BRT
  daysOfWeek DayOfWeek[] // ex: [MON, TUE, WED]

  // Resolução de conflito quando 2+ ofertas aplicáveis
  priority Int @default(0) // maior prioridade vence
  stackable Boolean @default(false) // se true, pode combinar com outras ofertas; se false, é exclusiva

  //Estado
  isActive Boolean @default(true)

  //Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?
  updatedBy Int?

  // Targets (M:N com cada tipo de alvo)
  products OfferProduct[]
  combos OfferCombo[]
  categories OfferCategory[]
  productTypes OfferProductType[]

  @@index([isActive])
  @@index([validFrom, validUntil])
  @@map("offers")
}

// Pivot tables - uma por tipo de target
model OfferProduct {
  offerId Int
  productId Int
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([offerId, productId])
  @@map("offer_products")
}

model OfferCombo {
  offerId Int
  comboId Int
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  combo Combo @relation(fields: [comboId], references: [id], onDelete: Cascade)
  @@id([offerId, comboId])
  @@map("offer_combos")
}

model OfferCategory {
  offerId Int
  categoryId Int
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@id([offerId, categoryId])
  @@map("offer_categories")
}

model OfferProductType {
  offerId Int
  productTypeId Int
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  productType ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  @@id([offerId, productTypeId])
  @@map("offer_product_types")
}

enum UserRole {
  SUPER_ADMIN // Dono/Gerente - controle total do sistema
  ADMIN // Funcionário admin - gerencia produtos, pedidos, relatórios
  STAFF // Funcionário operacional - processa pedidos, visualiza dados
  USER // Cliente - faz pedidos, visualiza histórico
  GUEST // Cliente sem cadastro - faz pedidos apenas com telefone
}

enum UserStatus {
  ACTIVE // Usuário ativo, pode usar o sistema
  INACTIVE // Inativo (pode reativar)
  SUSPENDED // Suspenso temporariamente (bloqueado)
  PENDING_VERIFICATION // Aguardando verificação de email
}

model User {
  id Int @id @default(autoincrement())

  // Identificação
  email     String? @unique // Opcional para GUEST (apenas telefone)
  password  String? // Opcional para GUEST (pode converter para USER depois)
  firstName String
  lastName  String
  phone     String  @unique // Obrigatório - identificador principal do GUEST
  cpf       String? @unique

  // Permissões e Status
  role   UserRole   @default(USER)
  status UserStatus @default(PENDING_VERIFICATION)

  // Datas importantes
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?
  emailVerifiedAt DateTime?

  // Auditoria (quem criou/editou este usuário)
  createdById Int?
  updatedById Int?
  createdBy   User? @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User? @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  // Soft delete (não remove do banco, apenas marca como deletado)
  deletedAt   DateTime?
  deletedById Int?
  deletedBy   User?     @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // Relações (usuários que este usuário criou/editou/deletou)
  createdUsers User[] @relation("UserCreatedBy")
  updatedUsers User[] @relation("UserUpdatedBy")
  deletedUsers User[] @relation("UserDeletedBy")

  // Índices para performance
  @@index([email])
  @@index([cpf])
  @@index([phone])
  @@index([role])
  @@index([status])
  @@map("users")
}
